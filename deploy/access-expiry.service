[Unit]
Description=AI Course Platform - access expiry reminders (tariff self)
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/ai-course-platform
EnvironmentFile=/root/ai-course-platform/.env
ExecStart=/root/ai-course-platform/venv/bin/python -m app.scripts.access_expiry
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

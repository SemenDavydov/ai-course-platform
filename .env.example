# Скопируй в .env и заполни своими значениями (файл .env в git не коммитить)

# App
APP_NAME="AI STORY: воплоти свою историю"
DEBUG=False
SECRET_KEY=your-secret-key-min-32-chars
ADMIN_SECRET_CODE=your-admin-secret
SITE_URL=https://your-domain.ru

# После оплаты — invite в закрытые Telegram-каналы
PRO_CHAT_INVITE_URL=https://t.me/+XEjS_T_aSqozN2Ri
VIP_CHAT_INVITE_URL=https://t.me/+rrTQSEiQjA4zMTQy
# Уведомление админу о VIP (личный чат добавляется вручную)
ADMIN_NOTIFY_EMAIL=
# ADMIN_TELEGRAM_ID=

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aicourse

# Telegram (бот и ссылка t.me/BOT_USERNAME на сайте)
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=YourBotUsername
# false — только сайт; true — legacy-бот (нужен, чтобы старые покупатели без email
# могли войти на сайт по кнопке «Войти на сайт»)
BOT_ENABLED=false
# Прокси до Telegram API: с хостинга в РФ api.telegram.org напрямую недоступен.
# На проде — адрес вашего Cloudflare Worker. Пусто — ходим напрямую.
TELEGRAM_API_BASE=

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Kinescope (видео)
KINESCOPE_API_KEY=
KINESCOPE_PROJECT_ID=

# Redis (Celery)
REDIS_URL=redis://localhost:6379/0

# SMTP (письма: подтверждение email, успешная оплата)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.ru

# Соцсети (лендинг: иконки в nav/footer/about — показываются только если URL непустой)
INSTAGRAM_URL=https://www.instagram.com/davydovacreator/
TIKTOK_URL=https://www.tiktok.com/@kolobesyanew

# Опционально
CLC_API_KEY=
